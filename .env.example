# Copy to ".env" (or add each line under Replit > Tools > Secrets) and edit.
# NEVER commit the real .env file or paste keys into chat/screenshots.
# Every setting is optional: with no keys the app still runs, you can sign up, upload, trim,
# write subtitles by hand, export SRT/VTT/TXT, render burned-in video and test purchases in DEMO mode.

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1                 # 0.0.0.0 on Replit / Docker / a server (.replit already sets it)
PORT=3000
DATA_DIR=                      # projects, videos, renders AND the account database. Default: ./data (keep it on persistent storage)
LOG_REQUESTS=true
PUBLIC_URL=                    # public https address of your site, e.g. https://my-app.replit.app (required for Stripe)

# --- Accounts ---------------------------------------------------------------
SESSION_DAYS=30                # how long a sign-in lasts
COOKIE_SECURE=auto             # auto = Secure cookie when PUBLIC_URL is https; true/false to force
AUTH_ATTEMPTS_MAX=30           # sign-in / sign-up requests per 15 minutes per IP

# --- AI provider: OpenRouter (https://openrouter.ai/keys) -- NEEDS AN API KEY -------------
#   Translation      -> FREE with the default model (rate limited).
#   Speech-to-text   -> NOT free on OpenRouter: billed per audio second from your OpenRouter credit.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TRANSLATION_MODEL=openrouter/free
TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
TRANSCRIPTION_CHUNK_MINUTES=10
OPENROUTER_APP_NAME=Subly AI
OPENROUTER_APP_URL=
# Optional: a DIFFERENT OpenAI-compatible service just for speech-to-text (leave empty to use OpenRouter)
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=

# --- Credits ------------------------------------------------------------------
FREE_MONTHLY_CREDITS=30        # every account gets this many at the start of each UTC month; unused ones expire
LOW_CREDIT_THRESHOLD=5         # in-app warning when the balance is at or below this
CREDITS_TRANSCRIBE_PER_MINUTE=1          # credits per started minute of video (speech-to-text)
CREDITS_TRANSLATE_MINUTES_PER_CREDIT=2   # one credit translates this many started minutes
CREDITS_RENDER_MINUTES_PER_CREDIT=5      # one credit renders this many started minutes of burned-in video
# Plan and pack prices/credits are in server/src/services/billing.ts (CATALOG). They are EXAMPLES: edit before going live.

# --- Payments -------------------------------------------------------------------
# PAYMENTS_MODE:  demo   = fake checkout page, NO real money (default when no Stripe key is set; for testing only)
#                 stripe = real Stripe Checkout (needs the three Stripe values below + PUBLIC_URL)
#                 off    = buying disabled
PAYMENTS_MODE=
PAYMENT_CURRENCY=usd
STRIPE_SECRET_KEY=             # sk_test_... while testing   -- NEEDS A STRIPE ACCOUNT
STRIPE_WEBHOOK_SECRET=         # whsec_... from the Stripe webhook endpoint (<PUBLIC_URL>/api/billing/webhook)
STRIPE_API_BASE=https://api.stripe.com

# --- Upload limits ----------------------------------------------------------
MAX_UPLOAD_MB=500
MAX_VIDEO_MINUTES=90
UPLOAD_TIMEOUT_MINUTES=30

# --- FFmpeg -------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FONTS_DIR=
RENDER_RETENTION_HOURS=24
MAX_CONCURRENT_RENDERS=1

# --- Security / networking ---------------------------------------------------
ALLOWED_ORIGINS=
TRUST_PROXY=false              # true ONLY behind your own reverse proxy
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=600
RATE_LIMIT_HEAVY_MAX=40
